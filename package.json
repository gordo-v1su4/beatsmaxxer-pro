{
  "name": "beatsmaxxer-pro",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "cd svelte && bun install && cd .. && bun run skills:link",
    "skills:link": "bun run scripts/link-agent-skills.ts",
    "dev": "cd svelte && bun run dev",
    "build": "cd svelte && bun run build",
    "preview": "cd svelte && bun run preview",
    "check": "cd svelte && bun run check",
    "test": "cd svelte && bun run test",
    "test:update-broken-fixtures": "cd svelte && bun run test:update-broken-fixtures",
    "test:local": "cd svelte && bun run test:local",
    "test:local:detached": "bash scripts/run-test-local-detached.sh",
    "test:local:log": "bash scripts/parse-test-local-log.sh",
    "benchmark:prepare": "bun run svelte/scripts/prepare-playback-benchmark.ts",
    "benchmark:run": "bun run svelte/scripts/run-playback-benchmark.ts",
    "benchmark:report": "bun run scripts/summarize-playback-benchmark.ts",
    "test:benchmark": "cd svelte && bun run test tests/unit/benchmark",
    "verify:browser": "cd svelte && bun run verify:browser",
    "verify:cloud-smoke": "cd svelte && bun run verify:cloud-smoke",
    "verify:issue25-cloud": "cd svelte && SKIP_VISUAL_PROOF=1 bun run verify:issue25-gpu",
    "verify:issue25-gpu": "cd svelte && bun run verify:issue25-gpu",
    "capture:visual-proof": "cd svelte && bun run capture:visual-proof",
    "verify:visual-proof": "cd svelte && bun run verify:visual-proof",
    "link-qa": "cd svelte && bash scripts/link-qa-media.sh",
    "demo": "cd svelte && bun run demo",
    "open": "cd svelte && bun run open",
    "dev:desktop": "bash scripts/dev-desktop.sh",
    "build:desktop-frontend": "cd svelte && TAURI_ENV_PLATFORM=1 bun run build",
    "build:desktop": "bun run build:desktop-frontend && cd desktop && bunx tauri build",
    "smoke:desktop": "bash scripts/desktop-smoke.sh",
    "qa:secret-scan": "bun run scripts/secret-scan.ts",
    "linear:bootstrap": "bun run scripts/linear-bootstrap.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
