# TEMPLATE ONLY — never loaded at runtime. Copy to repo-root `.env` and fill in values there.
#   cp .env.example .env
# `.env` is gitignored; `.env.example` stays empty so secrets are not committed.

ESSENTIA_ANALYSIS_ENABLED=false
# Web proxy + desktop Tauri (Rust analyze_rhythm reads these directly)
ESSENTIA_API_BASE_URL=
ESSENTIA_API_KEY=
# Cursor Cloud only — set in Runtime Secrets, never commit
# TS_AUTHKEY=
# These settings are server-side only. Web production also requires the same-origin function
# guard and published IP-keyed Vercel WAF rate limit documented in svelte/docs/ESSENTIA.md.
ESSENTIA_ANALYSIS_ENGINE=
# Optional: opt into experimental Rust IPC decode (synthetic test frames only until VideoToolbox lands)
# DESKTOP_NATIVE_DECODE=true
# Local test media folder (Windows example: C:\Users\Gordo\Documents\Github\beat-surfer-pro\test_media)
QA_MEDIA_DIR=
