# TEMPLATE ONLY — never loaded at runtime.
# Set real values in your local .env.local (git-ignored). Desktop/Tauri also reads repo-root `.env`.
#   cp .env.example .env.local

ESSENTIA_ANALYSIS_ENABLED=false
# Hosted Essentia Studio API (server-side proxy only — see svelte/docs/ESSENTIA.md)
ESSENTIA_API_BASE_URL=
ESSENTIA_API_KEY=
# Desktop Rust bridge: canonical HTTPS application origin, not the worker URL.
# Installed app reads %APPDATA%/dev.beatsmaxxer.pro.desktop/.env; enter its access
# code in the existing app dialog. Session cookie stays in Rust memory.
BMX_API_BASE_URL=
# Object-storage gateway for chunked Studio uploads (server-side only)
MEDIA_GATEWAY_URL=
MEDIA_GATEWAY_TOKEN=
MEDIA_GATEWAY_BUCKET=beatsmaxxer-pro
MEDIA_GATEWAY_USER_ID=beatsmaxxer-pro
MEDIA_GATEWAY_UPLOAD_PREFIX=media-uploads
# Optional GPU-only slow-motion preparation worker (server-side only)
INTERPOLATION_WORKER_URL=
# Self-hosted app's canonical HTTPS origin; required by runtime/server.ts.
APP_ORIGIN=
# These settings are server-side only. The self-hosted API keeps credential-holding
# proxies behind the existing access-session and request-origin checks.
# Legacy Vercel deployments additionally require the WAF rules in svelte/docs/ESSENTIA.md.
# Access gate. Set a PIN to require a code before the app or hosted analysis can
# be used. Unset/empty means no gate — the deployment is open.
APP_ACCESS_PIN=
ESSENTIA_ANALYSIS_ENGINE=
# Optional folder with local QA clips for browser gates (see svelte/scripts/setup-qa-media.sh)
QA_MEDIA_DIR=
# Curated public demo bundle, produced by bun scripts/prepare-demo-media.ts.
# In production mount this folder read-only; never point it at private media.
DEMO_MEDIA_ROOT=
