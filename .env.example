# TEMPLATE ONLY — never loaded at runtime. Copy to repo-root `.env` and fill in values there.
#   cp .env.example .env
# `.env` is gitignored; `.env.example` stays empty so secrets are not committed.

ESSENTIA_ANALYSIS_ENABLED=false
# Hosted Essentia Studio API (server-side proxy only — see essentia-endpoint/docs/STUDIO_INTEGRATION.md)
ESSENTIA_API_BASE_URL=https://essentia.v1su4.dev
ESSENTIA_API_KEY=
# RustFS media gateway for chunked Studio uploads (server-side only)
MEDIA_GATEWAY_URL=https://media.v1su4.dev
MEDIA_GATEWAY_TOKEN=
MEDIA_GATEWAY_BUCKET=beatsmaxxer-pro
MEDIA_GATEWAY_USER_ID=beatsmaxxer-pro
MEDIA_GATEWAY_UPLOAD_PREFIX=media-uploads
# Cursor Cloud only — set in Runtime Secrets, never commit
# TS_AUTHKEY=
# These settings are server-side only. Web production also requires the same-origin function
# guard and published IP-keyed Vercel WAF rate limit documented in svelte/docs/ESSENTIA.md.
# Access gate. Set a PIN to require a code before the app or hosted analysis can
# be used. Unset/empty means no gate — the deployment is open.
APP_ACCESS_PIN=
ESSENTIA_ANALYSIS_ENGINE=
# Local test media folder (Windows example: C:\Users\Gordo\Documents\Github\beatsmaxxer-pro\test_media)
QA_MEDIA_DIR=
