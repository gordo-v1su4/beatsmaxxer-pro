{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beatsmaxxer Pro",
  "version": "0.1.0",
  "identifier": "dev.beatsmaxxer.pro.desktop",
  "build": {
    "frontendDist": "../../svelte/build",
    "devUrl": "http://127.0.0.1:5175",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run --cwd .. build:desktop-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Beatsmaxxer Pro",
        "width": 2552,
        "height": 1440,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "maximized": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
