{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beat Surfer Pro",
  "version": "0.1.0",
  "identifier": "dev.beatsurfer.pro.desktop",
  "build": {
    "frontendDist": "../../svelte/build",
    "devUrl": "http://127.0.0.1:5175",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ../../svelte && TAURI_ENV_PLATFORM=1 bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Beat Surfer Pro",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
