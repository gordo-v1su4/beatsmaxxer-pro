{
	"name": "beatsmaxxer-pro-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:desktop": "TAURI_ENV_PLATFORM=1 vite dev --host 127.0.0.1 --port 5175 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && cp node_modules/@soundtouchjs/audio-worklet/.dist/soundtouch-processor.js static/soundtouch-processor.js 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"link-qa": "bash scripts/setup-qa-media.sh",
		"verify:fx": "bun scripts/fxlab/verify-fx.ts",
		"verify:setup": "bash scripts/verify-setup.sh",
		"verify:ui": "bash scripts/verify-ui.sh",
		"verify:playback": "bash scripts/verify-playback.sh",
		"verify:interaction": "bash scripts/verify-interaction.sh",
		"verify:stutter": "bash scripts/verify-stutter.sh",
		"verify:audio": "bash scripts/verify-audio.sh",
		"verify:beat": "bash scripts/verify-beat.sh",
		"capture:visual-proof": "bash scripts/capture-visual-proof.sh",
		"verify:visual-proof": "bash scripts/verify-visual-proof.sh",
		"capture:eight-video-proof": "bash scripts/capture-eight-video-proof.sh",
		"verify:eight-video-proof": "bash scripts/verify-eight-video-proof.sh",
		"verify:browser": "bash scripts/verify-ui.sh && bash scripts/verify-playback.sh && bash scripts/verify-interaction.sh && bash scripts/verify-stutter.sh && bash scripts/verify-audio.sh && bash scripts/verify-beat.sh && bash scripts/verify-visual-proof.sh",
		"verify:cloud-smoke": "bash scripts/verify-cloud-smoke.sh",
		"test:local": "bash scripts/verify-local.sh",
		"verify:all": "bash scripts/verify-local.sh",
		"demo": "bun scripts/open-qa-demo.ts",
		"open": "bash scripts/open-native.sh"
	},
	"optionalDependencies": {
		"@tauri-apps/api": "^2.4.0"
	},
	"devDependencies": {
		"@fontsource/anton": "^5.3.0",
		"@fontsource/archivo-black": "^5.3.0",
		"@fontsource/audiowide": "^5.3.0",
		"@fontsource/bungee": "^5.3.0",
		"@fontsource/russo-one": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22.19.17",
		"@webgpu/types": "^0.1.66",
		"mediabunny": "^1.51.0",
		"playwright": "^1.62.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.1.17",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@lucide/svelte": "^1.27.0",
		"@soundtouchjs/audio-worklet": "^2.1.0"
	}
}
