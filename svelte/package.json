{
	"name": "beat-surfer-pro-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && cp node_modules/@soundtouchjs/audio-worklet/.dist/soundtouch-processor.js static/soundtouch-processor.js 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"link-qa": "bash scripts/setup-qa-media.sh",
		"verify:ui": "bash scripts/verify-ui.sh",
		"verify:playback": "bash scripts/verify-playback.sh",
		"verify:interaction": "bash scripts/verify-interaction.sh",
		"verify:stutter": "bash scripts/verify-stutter.sh",
		"verify:all": "bun run test && bun run build && START_SERVER=0 STUTTER_MS=6000 bash scripts/verify-playback.sh && START_SERVER=0 bash scripts/verify-interaction.sh && START_SERVER=0 STUTTER_MS=6000 bash scripts/verify-stutter.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22.19.17",
		"@webgpu/types": "^0.1.66",
		"mediabunny": "^1.51.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.1.17",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-singlefile": "^2.3.2",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@lucide/svelte": "^1.27.0",
		"@soundtouchjs/audio-worklet": "^2.1.0"
	}
}
